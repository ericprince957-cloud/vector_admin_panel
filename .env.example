# ============================================
# Digital Bookstore - Environment Variables
# ============================================
# Copy this file to .env and fill in actual values.
# NEVER commit actual secrets to version control.
# ============================================

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bookstore_db

# Authentication
AUTH_SECRET=your-super-secret-auth-key-min-32-chars
SESSION_SECRET=your-session-secret-key

# Paystack Payment Gateway
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Storage (e.g., Supabase Storage, S3, etc.)
STORAGE_URL=https://your-storage-provider.com
STORAGE_KEY=your-storage-access-key
STORAGE_BUCKET_PRIVATE=bookstore-private
STORAGE_BUCKET_PUBLIC=bookstore-public

# Email Service
EMAIL_API_KEY=your-email-service-api-key
EMAIL_PROVIDER=sendgrid
EMAIL_FROM_NAME=Digital Bookstore
EMAIL_FROM_ADDRESS=noreply@digitalbookstore.ng

# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_COVER_SIZE_MB=5
MAX_BOOK_FILE_SIZE_MB=100
MAX_PREVIEW_SIZE_MB=20
